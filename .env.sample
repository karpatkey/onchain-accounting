# Alchemy API key — only RPC credential needed when using "rpc": "$ALCHEMY" in chain config (same as TestEnvConfigurator.getAlchemyUrl).
# For forge script use: --rpc-url "https://eth-mainnet.g.alchemy.com/v2/$ALCHEMY_API_KEY" (mainnet) or arb/gnosis/base/opt URLs with same key.
ALCHEMY_API_KEY=

# Explorer API keys for contract verification (forge verify-contract).
# Set the one(s) for the chain(s) you deploy to. Verify script uses:
#   Mainnet 1     -> ETHERSCAN_API_KEY
#   Arbitrum 42161 -> ARBISCAN_API_KEY
#   Gnosis 100    -> GNOSISSCAN_API_KEY
#   Optimism 10   -> OPTIMISM_ETHERSCAN_API_KEY
#   Base 8453     -> BASESCAN_API_KEY
ETHERSCAN_API_KEY=

# Used to deploy implementations (01) and run 02_DeployProxies (EOA); not used for Safe-controlled steps
PRIVATE_KEY=