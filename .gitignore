# Compiler files
cache/
out/
lcov.info

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/
# Dev-fork bootstrap (script/development/deploy/01_DeployNAV.s.sol) broadcasts under the real
# chain-id (1, 10, ...) of the forked chain, so the 31337 rule above doesn't catch it. These are
# local fork-sim run logs, not prod deploy records — ignore them by the dev script's unique name.
/broadcast/01_DeployNAV.s.sol/


# Dotenv file
.env
commit.msg

# Safe transactions
safe-transactions/
.claude/
pr1_body.md

# Agent/tooling session scaffolding (plans, specs, run ledgers) — local only, like .claude/
.omo/

# Coverage databases. Machine-specific SQLite state rewritten on every run, so a tracked copy
# conflicts with itself forever and no reviewer will ever read it. Tracked once by a `git add -A`
# after a coverage run; ignored here so the cause is fixed and not just the instance.
.coverage
.coverage.*

# Generated reports (regenerate locally; the refresh workflow builds refresh-report.md at runtime)
/comparison-report.md
/refresh-report.md
# Root-level NAV snapshot dumps (snapshot_production.py --out); keep them out of git
/snapshots/
# IDE settings
.idea/
