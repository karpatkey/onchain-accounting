# RPC endpoints for each deployed chain
# Copy this file to .env.local and fill in your provider URLs.
# Supports Alchemy, Infura, Ankr, etc. For local-anvil dev, these are overwritten by
# script/development/app/sync-app-env.sh to point at http://127.0.0.1:<port>.

NEXT_PUBLIC_RPC_URL_1=
NEXT_PUBLIC_RPC_URL_10=
NEXT_PUBLIC_RPC_URL_100=
NEXT_PUBLIC_RPC_URL_42161=
NEXT_PUBLIC_RPC_URL_8453=

# Auto-refresh interval in minutes. Omit or set to 0 to disable background polling.
# Example: NEXT_PUBLIC_AUTOREFRESH_INTERVAL_MIN=5
NEXT_PUBLIC_AUTOREFRESH_INTERVAL_MIN=

# NAVCalculator address — two ways to override the production CREATE2 default
# (`0x07938ddDfACa63679c4d3F1d80BBe6aB1a6aEB19`, same on every chain):
#
#   1. NEXT_PUBLIC_NAV_ADDRESS                  — global override, applied to every chain.
#                                                 Use when ALL deployments share one address.
#   2. NEXT_PUBLIC_NAV_ADDRESS_<chainId>        — per-chain override; wins over the global.
#                                                 Use for local-anvil dev where each chain's
#                                                 proxy address diverges (plain CREATE, not
#                                                 CREATE2, so the deployer nonce differs per
#                                                 forked chain). script/development/app/sync-app-env.sh
#                                                 writes these automatically after `deploy.sh`.
#
NEXT_PUBLIC_NAV_ADDRESS=
NEXT_PUBLIC_NAV_ADDRESS_1=
NEXT_PUBLIC_NAV_ADDRESS_10=
NEXT_PUBLIC_NAV_ADDRESS_100=
NEXT_PUBLIC_NAV_ADDRESS_42161=
NEXT_PUBLIC_NAV_ADDRESS_8453=
