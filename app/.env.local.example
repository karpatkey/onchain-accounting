# RPC endpoints for each deployed chain
# Copy this file to .env.local and fill in your provider URLs.
# Supports Alchemy, Infura, Ankr, etc.

NEXT_PUBLIC_RPC_URL_1=
NEXT_PUBLIC_RPC_URL_10=
NEXT_PUBLIC_RPC_URL_100=
NEXT_PUBLIC_RPC_URL_42161=
NEXT_PUBLIC_RPC_URL_8453=

# Auto-refresh interval in minutes. Omit or set to 0 to disable background polling.
# Example: NEXT_PUBLIC_AUTOREFRESH_INTERVAL_MIN=5
NEXT_PUBLIC_AUTOREFRESH_INTERVAL_MIN=

# NAVCalculator address. Defaults to the production CREATE2 deployment
# (0x07938ddDfACa63679c4d3F1d80BBe6aB1a6aEB19, same on every chain).
# Set this when pointing the app at a local-fork deployment with diverged bytecode.
NEXT_PUBLIC_NAV_ADDRESS=
