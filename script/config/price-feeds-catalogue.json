    "providers": {
      "Chainlink": {
        "interface": "AggregatorV3Interface",
        "decimals": 8,
        "lookup": "https://docs.chain.link/data-feeds/price-feeds/addresses"
      },
      "Redstone": {
        "interface": "AggregatorV3Interface (Classic Push / relayer-pushed)",
        "decimals": 8,
        "lookup": "https://app.redstone.finance/push-feeds",
        "note": "Deployment manifests live in a private repository. Only addresses verified on-chain at the time of this update are included. Contact Redstone or browse their app for the full current list."
      },
      "API3": {
        "interface": "AggregatorV2V3Interface (communal Api3ReaderProxyV1)",
        "decimals": 18,
        "default_heartbeat": 86400,
        "factory": "0x1Fe170311Cb13e3bfB96DeC8FAadcf97BF843381",
        "compute_fn": "computeCommunalApi3ReaderProxyV1Address(chainId, dapiName) — @api3/contracts npm package",
        "lookup": "https://market.api3.org",
        "note": "Computed proxy addresses are chain-agnostic (same on every chain). 'deployed' reflects a latestRoundData() liveness check at api3_liveness_checked date — re-verify before registering, especially for entries marked deployed=false (API3 deploys new proxies continuously)."
      }
    }
  },
